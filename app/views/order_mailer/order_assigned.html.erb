<% content_for :title, "New Order Assigned" %>

<h1 style="
  margin: 0 0 20px;
  font-size: 22px;
  font-weight: 600;
  color: #111827;
  text-align: center;
">
    New Order Assigned to You
</h1>

<p style="
  margin: 0 0 24px;
  font-size: 15px;
  line-height: 1.5;
  color: #374151;
  text-align: center;
">
    A new order has been assigned to you for processing.
</p>

<!-- Order Details -->
<div style="
  background-color: #f9fafb;
  border-radius: 8px;
  padding: 20px;
  margin: 24px 0;
">
    <p style="margin: 0 0 12px; font-size: 14px; font-weight: 600; color: #111827;">
        Order ID #<%= @order.id.to_s.first(8) %>
    </p>
    <p style="margin: 0 0 8px; font-size: 14px; color: #6b7280;">
        for <%= @order.user.first_name || @order.user.email %>
    </p>
    <p style="margin: 0 0 8px; font-size: 14px; color: #6b7280;">
    </p>
</div>

<!-- Products Section -->
<% if @order_items.any? %>
<h2 style="
    margin: 32px 0 16px;
    font-size: 18px;
    font-weight: 600;
    color: #111827;
  ">
    Items in this order:
</h2>

<% @order_items.each do |item| %>
<div style="
      background-color: #ffffff;
      margin: 12px 0;
      display: flex;
      gap: 16px;
    ">
    <% 
        image_url = nil
        if item.variant_stock
          options = item.variant_stock.variant_options.includes(:images)
          option_with_image = options.find { |opt| opt.images.any? }
          image_url = option_with_image&.images&.order(created_at: :desc)&.first&.url if option_with_image
        end
        image_url ||= @product&.images&.order(created_at: :desc)&.first&.url
      %>

    <% if image_url %>
    <img src="<%= image_url %>" alt="Product" style="
          width: 80px;
          height: 80px;
          object-fit: cover;
          border-radius: 6px;
          flex-shrink: 0;
        " />
    <% end %>

    <div style="flex: 1;">
        <p style="margin: 0 0 4px; font-size: 14px; color: #6b7280;">
            Product <%= @product&.name || "N/A" %>
        </p>
        <p style="margin: 0 0 4px; font-size: 15px; font-weight: 600; color: #111827;">
            <%= item.variant_stock_option_names || "Item" %>
        </p>
        <p style="margin: 0 0 4px; font-size: 14px; color: #6b7280;">
            Quantity: <%= item.quantity %>
        </p>
        <% if item.variant_stock_warehouse_name %>
        <p style="margin: 4px 0 0; font-size: 13px; color: #9ca3af;">
            Warehouse: <%= item.variant_stock_warehouse_name %>
        </p>
        <% end %>
    </div>
</div>
<% end %>
<% end %>

<!-- Fulfillments Section -->
<% if @fulfillments.any? %>
<h2 style="
    margin: 32px 0 16px;
    font-size: 18px;
    font-weight: 600;
    color: #111827;
  ">
    Fulfillments:
</h2>

<% @fulfillments.each do |fulfillment| %>
<div style="
      background-color: #ffffff;
      margin: 12px 0;
    ">
    <p style="margin: 0 0 8px; font-size: 14px; font-weight: 600; color: #111827;">
        <%= fulfillment.warehouse&.name || "N/A" %> Warehouse
    </p>
    <p style="margin: 0 0 4px; font-size: 14px; color: #6b7280;">
        Status <%= fulfillment.status.humanize %>
    </p>
    <% if fulfillment.delivery_date %>
    <p style="margin: 4px 0 0; font-size: 13px; color: #9ca3af;">
        Delivery <%= fulfillment.delivery_date.strftime("%B %d, %Y") %>
    </p>
    <% end %>
</div>
<% end %>
<% end %>

<div style="text-align: center; margin: 32px 0">
    <a href="<%= @order_url %>" style="
    display: inline-block;
    background-color: #e74f1c;
    color: #ffffff;
    padding: 12px 32px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
  ">View Order</a>
</div>

<p style="
  margin: 32px 0 0;
  font-size: 14px;
  color: #6b7280;
  text-align: center;
  line-height: 1.5;
">
    Please review this order and update its status as you process it.
</p>

<p style="
  margin: 32px 0 0;
  font-size: 14px;
  color: #6b7280;
  text-align: center;
  line-height: 1.5;
">
    Best regards,<br />
    The Kara Bloome Team
</p>