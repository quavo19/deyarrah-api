<% content_for :title, "Reset Your Password" %>

<h1 style="
  margin: 0 0 20px;
  font-size: 22px;
  font-weight: 600;
  color: #111827;
  text-align: center;
">
    Reset Your Password
</h1>

<p style="
  margin: 0 0 24px;
  font-size: 15px;
  line-height: 1.5;
  color: #374151;
  text-align: center;
">
    Hello <%= @user.first_name || @user.email %>,<br />
    You have requested to reset your password. Click the button below to reset it.
</p>

<div style="text-align: center; margin: 32px 0">
    <a href="<%= @reset_url %>" style="
    display: inline-block;
    background-color: #e74f1c;
    color: #ffffff;
    padding: 12px 32px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
  ">Reset Password</a>
</div>

<p style="
  margin: 0 0 20px;
  font-size: 14px;
  color: #6b7280;
  text-align: center;
  line-height: 1.5;
">
    Or copy and paste this link into your browser:<br />
    <a href="<%= @reset_url %>" style="color: #e74f1c; word-break: break-all;"><%= @reset_url %></a>
</p>

<p style="
  margin: 32px 0 0;
  font-size: 13px;
  color: #9ca3af;
  text-align: center;
  line-height: 1.5;
">
    This link will expire in 6 hours.<br />
    If you didn't request this, please ignore this email.
</p>